{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python scripts/prereg.py:*)",
      "Bash(python scripts/ledger.py:*)",
      "Bash(python scripts/render.py:*)",
      "Bash(python scripts/bounty.py:*)",
      "Bash(python scripts/open_checks.py:*)",
      "Bash(python scripts/never_fired.py:*)",
      "Bash(python scripts/inventory.py:*)",
      "Bash(python scripts/withdraw.py:*)",
      "Bash(python scripts/correspond.py:*)",
      "Bash(python scripts/submit.py:*)",
      "Bash(python scripts/verify.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git revert:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(python scripts/memories.py:*)",
      "Bash(python scripts/prune_runs.py:*)",
      "Bash(python scripts/deep_pass_process.py:*)",
      "Bash(python scripts/rooms.py:*)",
      "Bash(python scripts/sampler.py:*)",
      "Bash(python scripts/processes.py:*)",
      "Bash(python scripts/keep.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/open_threads.py"
            ],
            "timeout": 10,
            "statusMessage": "reading open telegram threads"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/deep_pass_handover.py"
            ],
            "timeout": 10,
            "statusMessage": "reading the last deep pass handover"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/memory_index.py"
            ],
            "timeout": 10,
            "statusMessage": "counting the memories"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/next_step.py"
            ],
            "timeout": 10,
            "statusMessage": "reading what we agreed to do next"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/room_notes.py"
            ],
            "timeout": 10,
            "statusMessage": "counting unread notes in the Nexus rooms"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/reminders.py"
            ],
            "timeout": 15,
            "statusMessage": "working out what is due"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/protect_state.py"
            ],
            "timeout": 15,
            "statusMessage": "checking state/ guard"
          }
        ]
      }
    ]
  }
}
