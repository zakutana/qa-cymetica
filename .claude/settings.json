{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python scripts/prereg.py:*)",
      "Bash(python scripts/ledger.py:*)",
      "Bash(python scripts/render.py:*)",
      "Bash(python scripts/bounty.py:*)",
      "Bash(python scripts/open_checks.py:*)",
      "Bash(python scripts/never_fired.py:*)",
      "Bash(python scripts/inventory.py:*)",
      "Bash(python scripts/withdraw.py:*)",
      "Bash(python scripts/correspond.py:*)",
      "Bash(python scripts/submit.py:*)",
      "Bash(python scripts/verify.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git revert:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(python scripts/memories.py:*)",
      "Bash(python scripts/prune_runs.py:*)",
      "Bash(python scripts/deep_pass_process.py:*)",
      "Bash(python scripts/rooms.py:*)",
      "Bash(python scripts/sampler.py:*)",
      "Bash(python scripts/processes.py:*)",
      "Bash(python scripts/keep.py:*)",
      "Bash(python scripts/lab.py:*)",
      "Bash(python scripts/channels.py:*)",
      "Bash(python scripts/nexus.py:*)",
      "Bash(python scripts/fomo_watch.py:*)",
      "Bash(python scripts/review.py:*)",
      "Bash(python scripts/gem_audit.py:*)",
      "Bash(python scripts/a2a.py:*)",
      "Bash(python scripts/clone.py:*)",
      "Bash(python scripts/wave.py:*)",
      "Bash(python scripts/league.py:*)",
      "Bash(python scripts/paper.py:*)",
      "Bash(python scripts/hot_watch.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/session_start.py"
            ],
            "timeout": 10,
            "statusMessage": "what is due, what is open, what is next"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/protect_state.py"
            ],
            "timeout": 15,
            "statusMessage": "checking state/ guard"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/no_heredoc_writes.py"
            ],
            "timeout": 15,
            "statusMessage": "checking no heredoc writes a file"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              ".claude/hooks/no_backtick_commit.py"
            ],
            "timeout": 15,
            "statusMessage": "checking no commit message runs a backtick"
          }
        ]
      }
    ]
  }
}
