{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python scripts/submit.py:*)",
      "Bash(python scripts/sweep.py:*)",
      "Bash(python scripts/bounty.py:*)",
      "Bash(python scripts/correspond.py:*)",
      "Bash(python scripts/a2a.py:*)",
      "Bash(python scripts/channels.py:*)",
      "Bash(python scripts/bb.py:*)",
      "Bash(python scripts/casino.py:*)",
      "Bash(python scripts/league.py:*)",
      "Bash(python scripts/gem_audit.py:*)",
      "Bash(python scripts/clone.py:*)",
      "Bash(python scripts/company.py:*)",
      "Bash(python scripts/memories.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git revert:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude', 'hooks', sys.argv[1]); sys.argv=[p]; runpy.run_path(p, run_name='__main__')",
              "session_start.py"
            ],
            "timeout": 10,
            "statusMessage": "what is next, what is open"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude', 'hooks', sys.argv[1]); sys.argv=[p]; runpy.run_path(p, run_name='__main__')",
              "no_heredoc_writes.py"
            ],
            "timeout": 15,
            "statusMessage": "checking no heredoc writes a file"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude', 'hooks', sys.argv[1]); sys.argv=[p]; runpy.run_path(p, run_name='__main__')",
              "no_backtick_commit.py"
            ],
            "timeout": 15,
            "statusMessage": "checking no commit message runs a backtick"
          }
        ]
      }
    ]
  }
}
