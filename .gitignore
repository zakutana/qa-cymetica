# Credentials -- never committed. The repo is public.
.env
*.key
*.pem

# Rebuildable projection of the journal. The journal is the source of truth.
state/qa.sqlite
state/qa.sqlite-*

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store
Thumbs.db

# The journal's append lock. A zero-byte file whose only job is to exist while
# one process holds it; committing it would put a machine's transient state in
# everyone's tree.
state/**/*.lock
state/*.lock

# Half-written snapshots. Every atomic write under state/ goes tmp-then-replace,
# and a process killed between the two leaves the tmp behind -- untracked, which
# means git status is dirty, which means prereg.py refuses and no run can reach
# level V. protect_state.py then blocks removing it from a shell, so the
# operator is left with a tree they cannot clean by the sanctioned route.
state/**/*.tmp
state/*.tmp
