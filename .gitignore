# Credentials -- never committed.
.env
*.key
*.pem
# Build it Better request tokens, ticket -> token (scripts/bb.py). Each is shown once, in the
# 201 that files the request, and lets its holder accept, change, judge or withdraw that ticket.
state/bb_tokens.json

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store
Thumbs.db

# Locks and half-written files under state/.
state/**/*.lock
state/*.lock
state/**/*.tmp
state/*.tmp

# What a run writes: rewritten all the time, and remade by running again. No capture body is kept and no gigabytes
# go in git.
state/runs/
state/bounty.json
state/pace.json
state/gem_audit/
state/casino/
state/league/
evidence/

# The /company mockup's downloaded textures and models (CC0, ambientCG and Poly Haven): the bodies stay out
# of git, outbox/company-live/assets.json (in git) names each file with its source, licence, bytes and sha256.
outbox/company-live/assets/

# Pictures our own scripts render from a page in git: each is remade by running its script; what a request text
# links (a spec/ folder, a picture named in request.txt) is committed by name and is not listed here. Exact paths,
# or a name pattern inside one folder of shots; never a repo-wide pattern like *-1440.png, which would silently keep
# out the next picture a request links.
outbox/company-skins/built-*.png
outbox/company-skins/settings-*.png
outbox/company-skins/showcase-*.png
outbox/company-skins/preview.png
outbox/company-promo-video/shots/
outbox/company-promo-video/shots-overview.png
outbox/company-flyer/flyer-1080x1350.png
outbox/revenue-share-flyer/flyer-1080x1350.png
outbox/revenue-share-flyer/slogan-v*.png
outbox/gem-screener-tiers/tiers-*.png
outbox/gem-screener-cards/card-1440.png
outbox/gem-screener-cards/cards-1440.png
outbox/gem-screener-cards/cards-before-1440.png
outbox/build-it-better-redesign/index.html
outbox/build-it-better-redesign/catalog-1920.png
outbox/build-it-better-redesign/first-screen-1920.png
outbox/build-it-better-redesign/page-1440.png
outbox/build-it-better-redesign/previews/
outbox/event-card-redesign/index.html
