# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The identity ladder. Testing whether the trust ladder gates anything requires
# calling the same endpoint as more than one identity and diffing the answers --
# a single credential can only show what one tier happens to receive.
#
#   anon        no key at all; needs no configuration
#   recognized  a freshly registered key (POST /mcp/v1/register)
#   trusted     the TRUSTED-tier key

QA_TRUSTED_KEY=
QA_RECOGNIZED_KEY=

# Documented in the handoff, required by no endpoint we have found so far.
# Recorded here so its (non-)use is itself a testable claim.
QA_HMAC_SECRET=

QA_TIMEOUT_SECONDS=30
