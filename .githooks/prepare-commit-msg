#!/bin/sh
# Record which effort wrote this commit, for the weekly retrospective.
#
# `Co-Authored-By` already names the model. Effort is the other half of the
# operator's table in CLAUDE.md, and nothing recorded it. $CLAUDE_EFFORT carries
# the EFFECTIVE value -- a subagent whose frontmatter says `effort: high` reads
# `high` inside a session set to `max` -- so the trailer says what actually ran,
# not what the session was set to.
#
# Silent in three cases, each on purpose:
#   * no $CLAUDE_EFFORT      the operator committing by hand. Nobody's effort
#                            setting wrote it, and inventing one would put a
#                            number in the retrospective that means nothing.
#   * a trailer already there an amend and a rebase both replay this hook, and
#                            two Effort: lines would be read as two commits.
#   * anything unexpected    exit 0 regardless. A bookkeeping hook may never be
#                            the reason a commit cannot be made.
#
# WHY `git interpret-trailers` AND NOT `printf`. Appending the line put it in
# the message; it did not make it a TRAILER. Git reads trailers out of the last
# paragraph, so a one-line commit message ("console poll") became "console poll
# Effort: max" -- the subject -- and a message whose last paragraph was prose
# swallowed it the same way. 73 of 188 commits on 2026-09-12 carried the line
# and git parsed none of them, which is a third of the evidence the week's
# third question rests on. interpret-trailers puts it where git will find it,
# inserting the blank line when one is needed.
#
# Installed with `git config core.hooksPath .githooks`, which lives in
# .git/config and cannot be committed -- so a fresh clone does not have it and
# tests/repo/test_commit_trailers.py reports that as inconclusive, not failed.
set -e

msg_file="$1"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0
[ -n "$CLAUDE_EFFORT" ] || exit 0

# Only a line in the exact shape of the trailer: the key, one word, nothing
# else. `^Effort:[[:space:]]` was the first version and it failed on the very
# first commit it ran on -- the one that added this hook, whose prose wrapped
# so that a line began "Effort: lines read as two commits". The hook read that
# as a trailer already present and added none. A body can say anything; a
# trailer is one word.
if grep -qiE '^Effort:[[:space:]]+[^[:space:]]+[[:space:]]*$' "$msg_file"; then
    exit 0
fi

git interpret-trailers --in-place --trailer "Effort: $CLAUDE_EFFORT" "$msg_file" \
    || printf '\nEffort: %s\n' "$CLAUDE_EFFORT" >> "$msg_file"
exit 0
