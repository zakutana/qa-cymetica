#!/bin/sh
# Bring the captures this commit's own state cites.
#
# evidence/ is gitignored since 2026-09-12: 7 747 files and 469 MB of it, of
# which 1 010 were cited by anything. What still has to be in the repository is
# what a clone needs to check us -- their answers the ledger stands on, and the
# request and response behind every verdict and report we have sent, which
# scripts/verify.py promises them "provided on request".
#
# Here rather than in the console's poller, which appends those events: the
# poller is a timer, and a timer writing .git/index races every commit a
# session makes. Here it runs inside the commit that records the event, which
# is the one moment the two cannot disagree.
#
# Silent unless it adds something or something goes wrong, and it can never be
# the reason a commit fails: tests/repo/test_evidence_in_git.py says the same
# thing afterwards, where somebody is looking. Installed with
# `git config core.hooksPath .githooks`, which a fresh clone does not have --
# the deep pass repairs that case in step 0.
#
# Since 2026-09-20 it also renders the dashboard the commit is about to carry.
# Rule 12 says the committed page must be a render of the committed state, and
# tests/repo/test_repo_consistency.py checks it -- but nothing PRODUCED that
# state, so the rule reduced to "the operator remembers" and broke three times
# in one session: twice on correspondence commits, once because adding a test
# moves the suite counts the page shows. `--if-stale` writes only when the
# page would change, so an ordinary commit stages nothing extra.

if command -v python >/dev/null 2>&1; then
    PY="python"
elif command -v py >/dev/null 2>&1; then
    PY="py -3"
else
    exit 0
fi

$PY scripts/keep.py track || true

# Only when the state going INTO this commit is the state on disk.
#
# The render reads the working tree. If state/ledger.json is modified and not
# staged -- commit a code change first, fold second, which is the ordinary
# order here -- then staging the page attaches a render of a ledger that is
# not in the commit. tests/repo also reads the working tree, so it stays
# green locally and rule 12 goes red on a fresh clone, where the working tree
# IS the commit. A pathspec-restricted commit does the same thing.
#
# So: if any state/ file differs between the index and the working tree, do
# nothing. The page is then stale in the commit, which the next full render
# fixes loudly, rather than wrong in a way only a clone can see.
if git diff --name-only -- state/ | grep -q .; then
    echo "pre-commit: state/ has unstaged changes; not touching the page" >&2
    exit 0
fi

# Staged only when the render succeeded: a stale page staged after a failed
# render is exactly what turns rule 12's guard red.
if $PY scripts/render.py --if-stale; then
    git add dashboard/index.html || true
fi
exit 0
